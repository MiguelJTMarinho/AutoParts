  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// Get token from collection\r",
          "let token = pm.collectionVariables.get(\"token\");\r",
          "\r",
          "// Simple JWT expiry check (decode payload)\r",
          "function isTokenExpired(tkn) {\r",
          "    if (!tkn) return true;\r",
          "\r",
          "    try {\r",
          "        const payload = JSON.parse(atob(tkn.split('.')[1]));\r",
          "        const now = Math.floor(Date.now() / 1000);\r",
          "\r",
          "        return payload.exp < now;\r",
          "    } catch (e) {\r",
          "        return true;\r",
          "    }\r",
          "}\r",
          "\r",
          "// If token is missing or expired → login again\r",
          "if (!token || isTokenExpired(token)) {\r",
          "\r",
          "    console.log(\"🔐 Token missing or expired. Logging in...\");\r",
          "\r",
          "    pm.sendRequest({\r",
          "        url: pm.collectionVariables.get(\"base_url\") + \"/api/users/login\",\r",
          "        method: \"POST\",\r",
          "        header: {\r",
          "            \"Content-Type\": \"application/json\"\r",
          "        },\r",
          "        body: {\r",
          "            mode: \"raw\",\r",
          "            raw: JSON.stringify({\r",
          "                email: pm.collectionVariables.get(\"email\"),\r",
          "                password: pm.collectionVariables.get(\"password\")\r",
          "            })\r",
          "        }\r",
          "    }, function (err, res) {\r",
          "        if (err) {\r",
          "            console.log(\"Login failed:\", err);\r",
          "            return;\r",
          "        }\r",
          "\r",
          "        const json = res.json();\r",
          "\r",
          "        // adjust this depending on your login response\r",
          "        const newToken = json.token || json.data?.token;\r",
          "\r",
          "        pm.collectionVariables.set(\"token\", newToken);\r",
          "\r",
          "        console.log(\"✅ New token stored\");\r",
          "    });\r",
          "}"
        ]
      }
    },
